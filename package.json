{
  "name": "rankings",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "migrate:math": "python3 backend/scripts/migrate_to_pg.py --discipline math --db math/backend/mathrankings.db",
    "migrate:physics": "python3 backend/scripts/migrate_to_pg.py --discipline physics --db physics/backend/physicsrankings.db"
  }
}
